.post 
    a(href="#").pfp: img(src="/images/nun.avif", alt="")
    .content 
        .info 
            .left
                a(href="#").name Lucy
                    img.verifiedMark(src="/svg/verified.svg")
                span.username @lucy_official 
                span.time - 20m

            span.menu <svg xmlns="http://www.w3.org/2000/svg" id="Outline" viewBox="0 0 24 24" width="512" height="512"><circle cx="2" cy="12" r="2"/><circle cx="12" cy="12" r="2"/><circle cx="22" cy="12" r="2"/></svg>

        .data 
            - var a = Math.random();

            if a > 0.66
                pre I've just broke my new teapot :(
            else if a > 0.33
                pre Day 1 of giving lisa to strangers 
                .images 
                    //- img(src="/images/img.jpg", alt="")
                    //- img(src="/images/nun.avif", alt="")
                    img(src="/images/nun.webp", alt="")
                    //- img(src="/images/lisa.jpg", alt="")
            else
                pre :3
                include _post
